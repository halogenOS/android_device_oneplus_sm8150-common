android_app {
    name: "AlertSliderController",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    sdk_version: "system_current",
    privileged: true,
    certificate: "platform",
    vendor: true,

    static_libs: [
        "vendor.oplus.hardware.alertslider-V1-java",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
