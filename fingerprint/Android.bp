cc_binary {
    name: "custom.hardware.biometrics.fingerprint.udfps-service.oplus",
    vintf_fragments: ["custom.hardware.biometrics.fingerprint.udfps-service.oplus.xml"],
    init_rc: ["custom.hardware.biometrics.fingerprint.udfps-service.oplus.rc"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "UdfpsExtension.cpp",
        "service.cpp",
    ],
    header_libs: [
        "generated_kernel_headers",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "custom.hardware.biometrics.fingerprint.udfps-V1-ndk",
    ],
}
