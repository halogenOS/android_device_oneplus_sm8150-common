type hal_custom_hardware_health_charging_default, domain;
hal_server_domain(hal_custom_hardware_health_charging_default, hal_custom_hardware_health_charging)

type hal_custom_hardware_health_charging_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_custom_hardware_health_charging_default)

binder_call(hal_custom_hardware_health_charging_default, servicemanager)

# Power supply uevents
allow hal_custom_hardware_health_charging_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

# Battery level and input suspend of the battery supply
allow hal_custom_hardware_health_charging_default vendor_sysfs_battery_supply:dir r_dir_perms;
allow hal_custom_hardware_health_charging_default vendor_sysfs_battery_supply:file rw_file_perms;

# Charging switch of the oplus charger
allow hal_custom_hardware_health_charging_default vendor_sysfs_usb_supply:dir r_dir_perms;
allow hal_custom_hardware_health_charging_default vendor_sysfs_usb_supply:file rw_file_perms;
